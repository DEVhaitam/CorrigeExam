# S5 — mysql-conns-30
# Layer:    L3
# Knob:     --max_connections
# Pair w/:  W3 grade at high intensity (must exceed connection ceiling)
# Symptom:  request errors spike, throughput cliffs at the connection limit
# Signal:   threads_connected plateaus at max_connections value, with
#           rising aborted_connects
# Fix:      MYSQL_MAX_CONNS=200

PROM_EXTERNAL_SCENARIO=S5-mysql-conns-30
PROM_EXTERNAL_WORKLOAD=W3-grade

# L3 — the perturbation. Set to 30 (well below MySQL 8 default of 151).
# At W3 high intensity (50 users x ~2 concurrent queries each), this saturates.
MYSQL_MAX_CONNS=30

# Everything else at baseline
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
MYSQL_BUFFER_POOL=1G
QUARKUS_DB_POOL_MAX=20
BACK_CPUS=2.0
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
