# S4 — mysql-buffer-128m
# Layer:    L3
# Knob:     --innodb_buffer_pool_size
# Pair w/:  W3 grade at medium intensity
# Symptom:  query p95 >3x baseline, throughput drops, CPU not saturated
# Signal:   buffer pool reads / read_requests > 0.05 (cache miss > 5%)
# Fix:      MYSQL_BUFFER_POOL=1G

PROM_EXTERNAL_SCENARIO=S4-mysql-buffer-128m
PROM_EXTERNAL_WORKLOAD=W3-grade

# L3 — the perturbation
MYSQL_BUFFER_POOL=128M

# Everything else at baseline
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
MYSQL_MAX_CONNS=200
QUARKUS_DB_POOL_MAX=20
BACK_CPUS=2.0
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
