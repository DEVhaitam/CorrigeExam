# S7 — cpu-cap-half
# Layer:    L4 (degenerate, via compose deploy.resources)
# Knob:     BACK_CPUS (cgroup CPU cap)
# Pair w/:  W4 mixed at medium intensity
# Symptom:  p99 rises 3-5x; throughput plateaus; host shows headroom.
# Signal:   container_cpu_cfs_throttled_seconds_total rate > 0.5/s sustained
#           on correctexam-back (unique fingerprint of cgroup throttling).
#           Distinguished from "needs bigger node" by host CPU NOT saturated.
# Fix:      BACK_CPUS=2.0
#
# This is the headline L4 scenario: closest analogue to the AWS instance-type
# problem and directly comparable to CherryPick-style baselines.
# Validatable on macOS S0 because cAdvisor reads cgroups inside the VM.

PROM_EXTERNAL_SCENARIO=S7-cpu-cap-half
PROM_EXTERNAL_WORKLOAD=W4-mixed

# L4 — the perturbation
BACK_CPUS=0.5

# Everything else at baseline
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNS=200
QUARKUS_DB_POOL_MAX=20
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
