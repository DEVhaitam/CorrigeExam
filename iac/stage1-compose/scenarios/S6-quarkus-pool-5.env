# S6 — quarkus-pool-5
# Layer:    L3
# Knob:     QUARKUS_DATASOURCE_JDBC_MAX_SIZE
# Pair w/:  W3 grade at medium intensity
# Symptom:  in-flight queries plateau at 5; request queue grows; DB itself is idle
# Signal:   agroal_active_count plateaus at 5, agroal_awaiting_count > 0,
#           AND mysql_global_status_threads_running far below capacity.
#           Inverse pattern of S5: bottleneck is in the app pool, not DB.
# Fix:      QUARKUS_DB_POOL_MAX=20

# This pair (S5/S6) is the cross-layer trap demo:
# Same user-facing symptom ("queries are slow"), opposite layer fixes.
# Without the diagnostic signal, a recommender can't tell them apart.

PROM_EXTERNAL_SCENARIO=S6-quarkus-pool-5
PROM_EXTERNAL_WORKLOAD=W3-grade

# L3 — the perturbation
QUARKUS_DB_POOL_MAX=5

# Everything else at baseline
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNS=200
BACK_CPUS=2.0
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
