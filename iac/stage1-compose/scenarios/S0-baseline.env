# S0 — baseline (control). All knobs at known-good values.
# Every other scenario's "Verify" step compares against runs of this one.

# Labels (propagate into Prometheus via external_labels)
PROM_EXTERNAL_SCENARIO=S0-baseline
PROM_EXTERNAL_WORKLOAD=

# L1 image
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# L3 config
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNS=200
QUARKUS_DB_POOL_MAX=20

# L4 (degenerate)
BACK_CPUS=2.0
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g

# Image tag (kept stable across scenarios)
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
