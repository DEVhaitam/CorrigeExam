# S1 — heap-256m
# Layer:    L1
# Knob:     JAVA_TOOL_OPTIONS -Xmx
# Pair w/:  W2 upload at medium intensity
# Symptom:  p99 latency >5x baseline, error rate >1%
# Signal:   GC pause rate >1/s AND heap_used/heap_max >0.9 sustained
# Fix:      JAVA_TOOL_OPTIONS=-Xmx2g (back to baseline)

PROM_EXTERNAL_SCENARIO=S1-heap-256m
PROM_EXTERNAL_WORKLOAD=W2-upload

# L1 — the perturbation
JAVA_TOOL_OPTIONS=-Xmx256m -Xms256m -XX:+UseG1GC -Xlog:gc*:/tmp/gc.log

# Everything else stays at baseline
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNS=200
QUARKUS_DB_POOL_MAX=20
BACK_CPUS=2.0
BACK_MEM=2g
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
