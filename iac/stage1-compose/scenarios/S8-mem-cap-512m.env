# S8 — mem-cap-512m
# Layer:    L4
# Knob:     BACK_MEM (cgroup memory cap)
# Pair w/:  W2 upload at medium intensity
# Symptom:  OOM killer fires; container restarts; uploads truncated mid-stream
# Signal:   container_memory_failcnt > 0 OR container restart count rises.
#           Distinguished from S1 (Xmx-256m) by JVM heap being healthy when
#           the kill happens — kill comes from the *container* layer, not JVM.
# Fix:      BACK_MEM=2g

PROM_EXTERNAL_SCENARIO=S8-mem-cap-512m
PROM_EXTERNAL_WORKLOAD=W2-upload

# L4 — the perturbation. 512m is below JVM Xmx of 2g, so the JVM
# *will* try to commit memory the cgroup won't allow.
BACK_MEM=512m

# Everything else at baseline
JAVA_TOOL_OPTIONS=-Xmx2g -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
MYSQL_BUFFER_POOL=1G
MYSQL_MAX_CONNS=200
QUARKUS_DB_POOL_MAX=20
BACK_CPUS=2.0
MYSQL_CPUS=2.0
MYSQL_MEM=2g
DOCKERHUB_USERNAME=haitamelhayani2002
IMAGE_TAG=latest
